# ---- Build output (CMake / MSBuild) ----
build/
*.obj
*.exe
*.pdb
*.ilk
*.lib
*.exp
CMakeCache.txt
CMakeFiles/

# ---- Python ----
__pycache__/
*.pyc
ui_settings.json

# ---- Generated screenshot artifacts ----
# Every render in here is regenerated from the source by main.c's --shot mode
# and tools/bmp2png.py, so none of it is committed: the .bmp, the .png and the
# generated HTML wrapper all fall out of one command.
shots/*.bmp
shots/*.png
shots/*.html

# ---- Tool / agent artifacts ----
.freebuff/

# ---- Editor / OS ----
.vs/
.vscode/
*.swp
Thumbs.db
desktop.ini
